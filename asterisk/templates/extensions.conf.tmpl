; =============================================================================
; Dialplan da secretária virtual.
; Valores entre ${...} nas seções [globals] foram preenchidos pelo entrypoint;
; o resto são variáveis do próprio Asterisk.
;
; Entrada:  provedor -> [from-provider] -> [agent-inbound]
;           1) CURL no agente (/internal/inbound) registra a chamada (número de
;              origem, DID, canal) e devolve um UUID;
;           2) Answer + AudioSocket(UUID, agente:9092) — áudio slin 8 kHz.
; Saída:    agente -> AMI Originate (CALL_UUID=...) -> [agent-outbound]
; Transferência: agente -> AMI Redirect -> [agent-transfer] -> Dial(OWNER_PHONE)
; =============================================================================

[general]
static=yes
writeprotect=yes
clearglobalvars=no

[globals]
AGENT_URL=http://${AGENT_HOST}:${AGENT_HTTP_PORT}
AGENT_AUDIO=${AGENT_HOST}:${AGENT_AUDIO_PORT}
INTERNAL_TOKEN=${INTERNAL_TOKEN}
OWNER_PHONE=${OWNER_PHONE}
DID=${SIP_DID}
TRUNK=provider

; Sub-rotina: avisa o agente que o canal desligou (útil se o AudioSocket nunca conectou).
[sub-notify-hangup]
exten => s,1,Set(CURLOPT(conntimeout)=2)
 same => n,Set(CURLOPT(httptimeout)=3)
 same => n,Set(NOTIFY=${CURL(${AGENT_URL}/internal/calls/${CALL_UUID}/hangup?token=${INTERNAL_TOKEN})})
 same => n,Return()

[from-provider]
exten => _[+0-9a-zA-Z].,1,Set(CALL_TO=${EXTEN})
 same => n,Goto(agent-inbound,s,1)
exten => s,1,Set(CALL_TO=${DID})
 same => n,Goto(agent-inbound,s,1)

[agent-inbound]
exten => s,1,NoOp(Chamada recebida de ${CALLERID(num)} para ${CALL_TO})
 same => n,Ringing()
 same => n,Set(CURLOPT(conntimeout)=3)
 same => n,Set(CURLOPT(httptimeout)=5)
 same => n,Set(CALL_UUID=${CURL(${AGENT_URL}/internal/inbound?token=${INTERNAL_TOKEN}&from=${URIENCODE(${CALLERID(num)})}&to=${URIENCODE(${CALL_TO})}&channel=${URIENCODE(${CHANNEL})})})
 same => n,Set(UUID_OK=${REGEX("^[0-9a-f-]{36}$" ${CALL_UUID})})
 same => n,GotoIf($["${UUID_OK}" = "1"]?answer)
 same => n,NoOp(Agente indisponível: ${CALL_UUID})
 same => n,Congestion(5)
 same => n,Hangup()
 same => n(answer),Answer()
 same => n,Wait(0.5)
 same => n,AudioSocket(${CALL_UUID},${AGENT_AUDIO})
 same => n,Hangup()
exten => h,1,GotoIf($["${CALL_UUID}" = ""]?done)
 same => n,Gosub(sub-notify-hangup,s,1)
 same => n(done),NoOp(fim)

[agent-outbound]
exten => s,1,NoOp(Ligação de saída ${CALL_UUID} para ${CALL_TO} atendida)
 same => n,Set(CURLOPT(conntimeout)=3)
 same => n,Set(CURLOPT(httptimeout)=5)
 same => n,Set(NOTIFY=${CURL(${AGENT_URL}/internal/calls/${CALL_UUID}/answered?token=${INTERNAL_TOKEN}&channel=${URIENCODE(${CHANNEL})})})
 same => n,AudioSocket(${CALL_UUID},${AGENT_AUDIO})
 same => n,Hangup()
exten => h,1,Gosub(sub-notify-hangup,s,1)

[agent-transfer]
exten => s,1,NoOp(Transferindo ${CALL_UUID} para ${OWNER_PHONE})
 same => n,GotoIf($["${OWNER_PHONE}" = ""]?fail)
 ; Muitos provedores rejeitam caller ID de terceiros: liga com o DID e mostra
 ; o número original no nome.
 same => n,Set(CALLERID(name)=Secretaria ${CALLERID(num)})
 same => n,Set(CALLERID(num)=${DID})
 same => n,Dial(PJSIP/${OWNER_PHONE}@${TRUNK},40)
 same => n(fail),Hangup()
exten => h,1,Gosub(sub-notify-hangup,s,1)
